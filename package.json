{
  "name": "easymediaconverter",
  "displayName": "Easy Media Converter 🍰",
  "description": "Convert image, audio, and video files using ffmpeg",
  "homepage": "https://github.com/lanly-dev/vscode-emc",
  "publisher": "lanly-dev",
  "version": "3.0.0",
    "sponsor": {
    "url": "https://github.com/sponsors/lanly-dev"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Easy",
    "Media",
    "Convert",
    "emc",
    "ffmpeg",
    "Image",
    "Audio",
    "Video",
    "jpg",
    "gif",
    "mp3",
    "mp4",
    "wav"
  ],
  "icon": "media/emc.png",
  "galleryBanner": {
    "color": "white",
    "theme": "light"
  },
  "qna": false,
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "EMC",
      "properties": {
        "emc.enableGpuAcceleration": {
          "type": "boolean",
          "default": false,
          "description": "Enable GPU acceleration (h264_nvenc - Nvidia) video encoding"
        },
        "emc.useCustomQuality": {
          "type": "boolean",
          "default": false,
          "description": "Use custom video and audio quality settings instead of defaults"
        },
        "emc.videoQuality": {
          "type": "number",
          "default": 23,
          "minimum": 0,
          "maximum": 51,
          "description": "Video encoding quality using VBR (CRF: 0=best, 51=worst). Lower values produce better quality but larger files."
        },
        "emc.audioQuality": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 9,
          "description": "Audio encoding quality (VBR: 0=best, 9=worst). For MP3: 0-9, lower is better quality."
        }
      }
    },
    "commands": [
      {
        "command": "emc.download",
        "title": "EMC: Download ffmpeg",
        "icon": "$(cloud-download)"
      },
      {
        "command": "emc.convertMp3",
        "title": "EMC: Convert to mp3"
      },
      {
        "command": "emc.convertMp4",
        "title": "EMC: Convert to mp4"
      },
      {
        "command": "emc.convertJpg",
        "title": "EMC: Convert to jpg"
      },
      {
        "command": "emc.convertWav",
        "title": "EMC: Convert to wav"
      },
      {
        "command": "emc.convertGif",
        "title": "EMC: Convert to gif"
      },
      {
        "command": "emc.revealFfmpegBin",
        "title": "EMC: Reveal ffmpeg binary location",
        "icon": "$(file-directory)"
      },
      {
        "command": "emc.addToQueue",
        "title": "EMC: Add to queue"
      },
      {
        "command": "emc.removeFromQueue",
        "title": "EMC: Remove from queue",
        "icon": "$(close)"
      },
      {
        "command": "emc.clearQueue",
        "title": "EMC: Clear queue",
        "icon": "$(clear-all)"
      },
      {
        "command": "emc.showQueueInfo",
        "title": "EMC: show information",
        "icon": "$(info)"
      },
      {
        "command": "emc.startConversionQueue",
        "title": "EMC: start conversion queue",
        "icon": "$(run-all)"
      },
      {
        "command": "emc.changeVideoQuality",
        "title": "EMC: Change video quality",
        "icon": "$(edit)"
      },
      {
        "command": "emc.changeAudioQuality",
        "title": "EMC: Change audio quality",
        "icon": "$(edit)"
      },
      {
        "command": "emc.toggleGpu",
        "title": "EMC: Toggle GPU acceleration",
        "icon": "$(edit)"
      },
      {
        "command": "emc.toggleCustomQuality",
        "title": "EMC: Toggle custom quality",
        "icon": "$(lightbulb)"
      },
      {
        "command": "emc.toggleBinCheck",
        "title": "EMC: Toggle binary check",
        "icon": "$(edit)"
      },
      {
        "command": "emc.openSettings",
        "title": "EMC: Open settings",
        "icon": "$(gear)"
      },
      {
        "command": "emc.refreshBinCheck",
        "title": "EMC: Refresh binary check",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "EMC_TREEVIEW",
          "name": "Easy Media Converter",
          "contextualTitle": "🍰",
          "icon": "media/emc.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "EMC_SUBMENU",
        "label": "EMC"
      }
    ],
    "viewsWelcome": [
      {
        "view": "EMC_TREEVIEW",
        "contents": "Loading... Please wait for the extension to initialize."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "emc.convertMp3",
          "when": "false"
        },
        {
          "command": "emc.convertMp4",
          "when": "false"
        },
        {
          "command": "emc.convertJpg",
          "when": "false"
        },
        {
          "command": "emc.convertWav",
          "when": "false"
        },
        {
          "command": "emc.addToQueue",
          "when": "false"
        },
        {
          "command": "emc.removeFromQueue",
          "when": "false"
        },
        {
          "command": "emc.clearQueue",
          "when": "false"
        },
        {
          "command": "emc.showQueueInfo",
          "when": "false"
        },
        {
          "command": "emc.startConversionQueue",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "submenu": "EMC_SUBMENU",
          "group": "emc"
        }
      ],
      "EMC_SUBMENU": [
        {
          "command": "emc.convertJpg",
          "when": "resourceExtname =~ /\\.(gif|jpg|jpeg|png|webp)$/",
          "group": "1_convert@1"
        },
        {
          "command": "emc.convertMp3",
          "when": "resourceExtname =~ /\\.(ape|flac|mp3|wav|wma|avi|flv|mkv|mp4|ts|webm|wmv)$/",
          "group": "1_convert@2"
        },
        {
          "command": "emc.convertWav",
          "when": "resourceExtname =~ /\\.(ape|flac|mp3|wav|wma|avi|flv|mkv|mp4|ts|webm|wmv)$/",
          "group": "1_convert@3"
        },
        {
          "command": "emc.convertMp4",
          "when": "resourceExtname =~ /\\.(avi|flv|gif|mkv|mp4|ts|webm|wmv)$/",
          "group": "2_video@1"
        },
        {
          "command": "emc.convertGif",
          "when": "resourceExtname =~ /\\.(jpg|avi|flv|mkv|mp4|ts|webm|webp|wmv)$/",
          "group": "2_video@2"
        },
        {
          "command": "emc.addToQueue",
          "when": "resourceExtname =~ /\\.(jpg|jpeg|png|webp|ape|flac|mp3|wav|wma|avi|flv|mkv|mp4|ts|webm|wmv)$/",
          "group": "4_queue@1"
        }
      ],
      "view/title": [
        {
          "view": "EMC_TREEVIEW",
          "command": "emc.openSettings",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "emc.removeFromQueue",
          "when": "viewItem == EMC_TREEVIEW_ITEM",
          "group": "inline"
        },
        {
          "command": "emc.changeAudioQuality",
          "when": "viewItem == EMC_SETTING_AUDIO_QUALITY",
          "group": "inline"
        },
        {
          "command": "emc.changeVideoQuality",
          "when": "viewItem == EMC_SETTING_VIDEO_QUALITY",
          "group": "inline"
        },
        {
          "command": "emc.toggleCustomQuality",
          "when": "viewItem == EMC_SETTING_QUALITY",
          "group": "inline"
        },
        {
          "command": "emc.toggleGpu",
          "when": "viewItem == EMC_SETTING_GPU",
          "group": "inline"
        },
        {
          "command": "emc.download",
          "when": "viewItem == EMC_SETTING_BIN_CHECK && EMC_BIN_MISSING",
          "group": "inline@1"
        },
        {
          "command": "emc.revealFfmpegBin",
          "when": "viewItem == EMC_SETTING_BIN_CHECK && !EMC_BIN_MISSING",
          "group": "inline@3"
        },
        {
          "command": "emc.refreshBinCheck",
          "when": "viewItem == EMC_SETTING_BIN_CHECK",
          "group": "inline@2"
        },
        {
          "command": "emc.clearQueue",
          "group": "inline",
          "when": "viewItem == EMC_QUEUE_LABEL_ITEM && EMC_ITEM_COUNT > 0 && !EMC_QUEUE_RUNNING"
        },
        {
          "command": "emc.showQueueInfo",
          "group": "inline",
          "when": "viewItem == EMC_QUEUE_LABEL_ITEM && EMC_ITEM_COUNT > 0"
        },
        {
          "command": "emc.startConversionQueue",
          "group": "inline",
          "when": "viewItem == EMC_QUEUE_LABEL_ITEM && EMC_QUEUE_CONVERTIBLE && !EMC_QUEUE_RUNNING"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "test-compile": "tsc -p ./",
    "test:quality": "ts-node --project tsconfig.test.json test/scripts/test-quality.ts",
    "webpack-dev": "webpack --mode development --watch",
    "webpack": "webpack --mode development",
    "vsce-package": "vsce package",
    "efix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "26.x",
    "@types/tar": "^7.0.87",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "ovsx": "^1.1.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.19.0",
    "pretty-bytes": "^7.1.1",
    "tar": "^7.5.22"
  },
  "repository": {
    "url": "https://github.com/lanly-dev/vscode-emc"
  },
  "license": "MIT"
}